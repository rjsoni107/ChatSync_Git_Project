{
  "expo": {
    "name": "ChatSync",
    "slug": "chatsync",
    "scheme": "chatsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111b21"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatsync.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111b21"
      },
      "package": "com.chatsync.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ChatSync to access your photos to share images in chats.",
          "cameraPermission": "Allow ChatSync to access your camera to take photos."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
